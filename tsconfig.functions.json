{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"] }
  },
  "include": [
    "supabase/types/deno-env.d.ts",
    "supabase/functions/_shared/hmac.ts",
    "supabase/functions/_shared/backoff.ts",
    "supabase/functions/_shared/redact.ts",
    "supabase/functions/_shared/einvoice.ts",
    "supabase/functions/_shared/stores.ts",
    "supabase/functions/_shared/llm.ts",
    "supabase/functions/_shared/adapters.ts",
    "supabase/functions/_shared/worker.ts",
    "supabase/functions/_shared/edge.ts",
    "supabase/functions/integration-worker/index.ts",
    "supabase/functions/einvoice/index.ts",
    "supabase/functions/ewaybill/index.ts",
    "supabase/functions/bank-feed/index.ts",
    "supabase/functions/gps-intake/index.ts",
    "supabase/functions/store-webhooks/index.ts",
    "supabase/functions/help-agent/index.ts",
    "supabase/functions/help-whatsapp/index.ts"
  ]
}
