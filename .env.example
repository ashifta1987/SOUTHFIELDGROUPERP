# Browser-safe values only. Copy to .env.local for local dev and set the same names in Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side secrets do NOT belong here. Set them with `supabase secrets set` for Edge Functions:
#   SUPABASE_SERVICE_ROLE_KEY (or the new secret key)
#   WHATSAPP_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN
#   HELP_AI_PROVIDER, HELP_AI_API_KEY, HELP_AI_REGION
#   GSP_CLIENT_ID, GSP_CLIENT_SECRET (e-invoice / e-way bill, Phase 8)
# Dev only: WHATSAPP_TEST_ALLOWLIST=+91XXXXXXXXXX,+91XXXXXXXXXX
