{
  "name": "southfield-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:push": "supabase db push --db-url \"postgresql://postgres.${SUPABASE_REF:-fxwoabbwzcifxzqsmrie}:${DB_PASSWORD}@aws-0-ap-south-1.pooler.supabase.com:5432/postgres\" --yes",
    "db:test": "node scripts/pgtap.mjs",
    "db:types": "supabase gen types typescript --db-url \"postgresql://postgres.${SUPABASE_REF:-fxwoabbwzcifxzqsmrie}:${DB_PASSWORD}@aws-0-ap-south-1.pooler.supabase.com:5432/postgres\" --schema api > /tmp/sf-types.ts && (echo \"// Generated by: pnpm db:types (supabase gen types typescript --schema api). Do not edit by hand.\"; cat /tmp/sf-types.ts) > src/shared/database.types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/supabase-js": "^2.118.0",
